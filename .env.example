# Stripe のテスト用キー（sk_test_... / whsec_...）。未設定の場合はデモモードで動作し、実際の決済は行いません。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# サイトの公開URL（決済後の戻り先に使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 事務手数料（%）。寄付額のうちこの割合を Lumiere Conseil が受け取り、残りが受取先へ直接入金されます。
# Stripe Connect で受取先に直接送金する場合のみ適用。既定 10。
PLATFORM_FEE_PERCENT=10
# 管理者トークン。審査済みの申請に Stripe Connect 登録リンクを発行する /api/connect/onboard を呼ぶ際、
# x-admin-token ヘッダーで送ります。長いランダム文字列を設定してください（例: openssl rand -hex 32）。
# 未設定の場合、このAPIは 503 を返します。
ADMIN_TOKEN=
# Postgres の接続文字列（Neon, Supabase など）。未設定ならメモリに保存（再起動で消えます）。
DATABASE_URL=
# 米ドル建て寄付を円換算するレート（集計用）
USD_JPY_RATE=150
